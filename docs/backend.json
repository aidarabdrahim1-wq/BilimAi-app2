{
  "entities": {
    "StudentProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StudentProfile",
      "type": "object",
      "description": "Represents a student's personal learning profile, including their settings, progress, and preferences.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the StudentProfile entity."
        },
        "fullName": {
          "type": "string",
          "description": "The full name of the student."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The student's email address."
        },
        "grade": {
          "type": "string",
          "description": "The student's current academic class or grade level."
        },
        "currentScore": {
          "type": "number",
          "description": "The student's current overall score or performance metric."
        },
        "targetScore": {
          "type": "number",
          "description": "The student's desired target score or goal."
        },
        "rating": {
          "type": "number",
          "description": "The student's gamification points."
        },
        "subjectCombination": {
          "type": "string",
          "description": "The selected UNT subject combination."
        },
        "selectedSubjects": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of all subjects currently being studied."
        },
        "targetCareer": {
          "type": "string",
          "description": "The student's target career path."
        },
        "untDate": {
          "type": "string",
          "format": "date",
          "description": "Target UNT examination date."
        },
        "role": {
          "type": "string",
          "enum": ["student", "admin"],
          "description": "User access level."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the student profile was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "fullName",
        "email",
        "createdAt"
      ]
    },
    "Announcement": {
      "title": "Announcement",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["urgent", "success", "info"] },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "type", "date"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/studentProfiles/{studentId}": {
      "schema": "StudentProfile",
      "description": "Stores a student's personal learning profile."
    },
    "/announcements/{annId}": {
      "schema": "Announcement",
      "description": "Platform-wide announcements."
    }
  }
}