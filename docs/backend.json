
{
  "entities": {
    "StudentProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StudentProfile",
      "type": "object",
      "description": "Represents a student's personal learning profile, including their settings, progress, and preferences.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the StudentProfile entity."
        },
        "name": {
          "type": "string",
          "description": "The full name of the student."
        },
        "className": {
          "type": "string",
          "description": "The student's current academic class or grade level."
        },
        "currentScore": {
          "type": "number",
          "description": "The student's current overall score or performance metric."
        },
        "targetScore": {
          "type": "number",
          "description": "The student's desired target score or goal."
        },
        "rating": {
          "type": "number",
          "description": "The student's gamification points."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the student profile was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "currentScore",
        "targetScore",
        "createdAt"
      ]
    },
    "Announcement": {
      "title": "Announcement",
      "type": "object",
      "description": "A global announcement for all students.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["urgent", "success", "info"] },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "type", "date"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/studentProfiles/{studentId}",
        "definition": {
          "entityName": "StudentProfile",
          "schema": {
            "$ref": "#/backend/entities/StudentProfile"
          },
          "description": "Stores a student's personal learning profile."
        }
      },
      {
        "path": "/announcements/{announcementId}",
        "definition": {
          "entityName": "Announcement",
          "schema": {
            "$ref": "#/backend/entities/Announcement"
          },
          "description": "Stores global announcements."
        }
      }
    ]
  }
}
