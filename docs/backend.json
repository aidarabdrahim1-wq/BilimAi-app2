
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Student profile data for UNT preparation.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "grade": { "type": "string" },
        "targetScore": { "type": "number" },
        "currentScore": { "type": "number" },
        "rating": { "type": "number" },
        "solvedQuestions": { "type": "number" },
        "correctAnswers": { "type": "number" },
        "completedPlans": { "type": "number" },
        "streakDays": { "type": "number" },
        "selectedSubjects": { "type": "array", "items": { "type": "string" } },
        "subjectCombination": { "type": "string" },
        "targetCareer": { "type": "string" },
        "weakTopics": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "TestResult": {
      "title": "Test Result",
      "description": "Historical record of a test completed by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "testId": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "correctAnswers": { "type": "number" },
        "percentage": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Mistake": {
      "title": "User Mistake",
      "description": "Record of a question answered incorrectly.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "questionId": { "type": "string" },
        "subject": { "type": "string" },
        "selectedAnswer": { "type": "string" },
        "correctAnswer": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Stores individual student profiles."
    },
    "/test_results/{resultId}": {
      "schema": "#/entities/TestResult",
      "description": "Stores test performance history."
    },
    "/mistakes/{mistakeId}": {
      "schema": "#/entities/Mistake",
      "description": "Stores questions answered incorrectly for later review."
    }
  }
}
