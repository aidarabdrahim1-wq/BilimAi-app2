rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      let adminEmails = [
        'admin@bilimai.kz',
        'aaidarabdrahim1@gmail.com',
        'aidarabdrahim1@gmail.com',
        'abdrahimaidar1@gmail.com'
      ];
      return isSignedIn() && (
        request.auth.token.email in adminEmails ||
        (exists(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data.get('role', 'student') == 'admin')
      );
    }

    match /studentProfiles/{studentId} {
      // Тізімдеуге және жеке оқуға рұқсат (Рейтинг үшін керек)
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() && (request.auth.uid == studentId || isAdmin());
      
      // Иесіне профилін жаңартуға рұқсат, бірақ рөл мен email-ді қорғау.
      allow update: if isSignedIn() && (request.auth.uid == studentId || isAdmin()) && 
        (isAdmin() || (
          request.resource.data.get('role', resource.data.get('role', 'student')) == resource.data.get('role', 'student') &&
          request.resource.data.get('email', resource.data.get('email', '')) == resource.data.get('email', '')
        ));
      
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if isOwner(studentId) || isAdmin();
        allow write: if isOwner(studentId) || isAdmin();
      }
    }

    match /announcements/{annId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
  }
}