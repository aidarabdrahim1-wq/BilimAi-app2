rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@bilimai.kz' ||
        request.auth.token.email == 'aaidarabdrahim1@gmail.com' ||
        request.auth.token.email == 'aidarabdrahim1@gmail.com' ||
        (exists(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data.get('role', 'student') == 'admin')
      );
    }

    match /studentProfiles/{studentId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isOwner(studentId);
      
      // Allow update ONLY for tracking fields for owners. Profile fields are Admin-only.
      allow update: if isAdmin() || (isOwner(studentId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'fullName', 'grade', 'targetScore', 'subjectCombination', 'selectedSubjects', 'role', 'email', 'targetCareer', 'untDate'
        ]));
      
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if isOwner(studentId) || isAdmin();
        allow write: if isOwner(studentId) || isAdmin();
      }
    }

    match /announcements/{annId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
  }
}
