rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Пайдаланушы тек өз деректерін оқи және жаза алады
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // AI куратор хабарламалары
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Тест нәтижелері
    match /test_results/{resultId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Қателер базасы
    match /mistakes/{mistakeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Оқу жоспарлары
    match /study_plans/{planId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Диагностика
    match /diagnostics/{diagId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Теория (барлығына оқуға рұқсат)
    match /theory_materials/{materialId} {
      allow read: if request.auth != null;
      allow write: if false; 
    }
    
    // Жалпы прогресс
    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}