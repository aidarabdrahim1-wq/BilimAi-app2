rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@bilimai.kz' ||
        request.auth.token.email == 'aaidarabdrahim1@gmail.com' ||
        request.auth.token.email == 'aidarabdrahim1@gmail.com' ||
        (exists(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data.get('role', 'student') == 'admin')
      );
    }

    match /studentProfiles/{studentId} {
      // Кез келген жүйеге кірген оқушы басқалардың профилін көре алады (рейтинг үшін)
      allow read: if isSignedIn();
      
      // Тек иесі ғана өз профилін жасай алады
      allow create: if isOwner(studentId);
      
      // Иесі немесе Админ профильді жаңарта алады
      allow update: if isOwner(studentId) || isAdmin();
      
      // Тек Админ ғана профильді өшіре алады
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if isOwner(studentId) || isAdmin();
        allow write: if isOwner(studentId) || isAdmin();
      }
    }

    match /announcements/{annId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
  }
}